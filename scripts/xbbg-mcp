#!/usr/bin/env sh
set -eu

# The launcher does not search for the Bloomberg runtime. xbbg-mcp finds and loads it itself
# (explicit XBBG_MCP_LIB_DIR, BLPAPI_LIB_DIR, BLPAPI_ROOT, XBBG_DEV_SDK_ROOT, the vendored SDK of a
# checkout, hint directories, a Bloomberg Terminal install, the library search path variables, the
# xbbg cache). It only passes what the binary cannot know:
#
#   XBBG_MCP_HINT_DIRS  the directory of the Python `blpapi` package, when one is installed
#   XBBG_MCP_REPO_ROOT  this checkout, when the launcher runs from one
#
# Neither overrides a value already set in the environment, and nothing here touches
# DYLD_LIBRARY_PATH, LD_LIBRARY_PATH or PATH.

warn() {
    printf 'xbbg-mcp: %s\n' "$1" >&2
}

die() {
    warn "$1"
    exit 1
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

choose_python() {
    if command_exists python3; then
        printf '%s\n' python3
        return 0
    fi

    if command_exists python; then
        printf '%s\n' python
        return 0
    fi

    return 1
}

script_dir() {
    CDPATH= cd -- "$(dirname -- "$0")" && pwd
}

# The directory of the Python `blpapi` package, found without importing it.
find_python_blpapi_dir() {
    py=$(choose_python) || return 1
    "$py" - <<'PY'
from __future__ import annotations

import importlib.util
from pathlib import Path

try:
    spec = importlib.util.find_spec("blpapi")
except (ImportError, ValueError):
    raise SystemExit(1)

origin = getattr(spec, "origin", None)
if not origin or origin in ("built-in", "frozen"):
    raise SystemExit(1)

print(Path(origin).resolve().parent)
PY
}

find_real_binary() {
    if [ "${XBBG_MCP_REAL_BIN:-}" ] && [ -x "$XBBG_MCP_REAL_BIN" ]; then
        printf '%s\n' "$XBBG_MCP_REAL_BIN"
        return 0
    fi

    home=$(script_dir)
    for candidate in \
        "$home/xbbg-mcp-real" \
        "$home/.xbbg-mcp-real" \
        "$home/../share/xbbg-mcp/bin/xbbg-mcp-real" \
        "$home/../target/release/xbbg-mcp" \
        "$home/../target/debug/xbbg-mcp"
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

export_runtime_hints() {
    if [ -z "${XBBG_MCP_HINT_DIRS:-}" ]; then
        hint_dir=$(find_python_blpapi_dir 2>/dev/null) || hint_dir=
        if [ -n "$hint_dir" ]; then
            export XBBG_MCP_HINT_DIRS="$hint_dir"
        fi
    fi

    if [ -z "${XBBG_MCP_REPO_ROOT:-}" ]; then
        repo_root=$(CDPATH= cd -- "$(script_dir)/.." 2>/dev/null && pwd || true)
        if [ -n "$repo_root" ] && [ -f "$repo_root/Cargo.toml" ] && [ -d "$repo_root/apps/xbbg-mcp" ]; then
            export XBBG_MCP_REPO_ROOT="$repo_root"
        fi
    fi
}

REAL_BIN=$(find_real_binary) || die "could not locate the real xbbg-mcp binary. Reinstall it or set XBBG_MCP_REAL_BIN."

export_runtime_hints
exec "$REAL_BIN" "$@"
