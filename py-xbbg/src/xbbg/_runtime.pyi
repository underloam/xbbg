# Hand-written: xbbg._runtime is not generated by pyo3-stub-gen. It links no Bloomberg code.
import os
from typing import TypedDict

class CachedRuntime(TypedDict):
    version: str
    platform: str
    lib_path: str
    lib_sha256: str
    source: str
    install_dir: str

class RejectedInstall(TypedDict):
    install_dir: str
    reason: str

class CacheScan(TypedDict):
    runtimes: list[CachedRuntime]
    rejected: list[RejectedInstall]

def default_cache_root() -> str | None: ...
def scan_cache(
    cache_root: str | os.PathLike[str] | None = None,
    platform: str | None = None,
) -> CacheScan: ...
